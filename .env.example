# MusicBrainz rejette toute requête sans User-Agent identifiable
# (nom d'application + contact).
HTTP_USER_AGENT="ReveilMusical/1.0 (prenom.nom@ecole.fr)"
HTTP_TIMEOUT_MS=3000

# Ordre de priorité des fournisseurs : itunes | musicbrainz
# Liste vide = morceau de secours local uniquement.
MUSIC_PROVIDERS=itunes,musicbrainz
MUSIC_CACHE_TTL_SECONDS=86400

# Canaux installés : email | sms | push
NOTIFICATION_CHANNELS=email,sms,push
EMAIL_SENDER=reveil@reveil-musical.example

# Si tous les canaux échouent : nombre de tours d'essai et pause entre deux tours
NOTIFICATION_ROUNDS=3
NOTIFICATION_RETRY_DELAY_MS=2000

# Dernières préférences connues, réutilisées si le service de préférences tombe
PREFERENCES_CACHE_FILE=.reveil-musical/preferences.json

# Démonstration du mode dégradé : pannes simulées (email | sms | push | preferences)
SIMULATED_OUTAGES=
